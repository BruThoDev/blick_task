{% if section.blocks.size > 0 %}
  <div
    class="product-usps section section--page-width"
    style="background-color: {{ section.settings.background_color }}"
  >
    <div class="product-usps__grid">
      {%- for block in section.blocks -%}
        <div class="product-usps__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="product-usps__icon">
              {{- block.settings.image | image_url: width: 30 | image_tag: loading: 'lazy' -}}
            </div>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <span class="product-usps__label">{{ block.settings.label }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product USPs",
  "tag": "div",
  "class": "product-usps-wrapper",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Text",
          "default": "USP"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product USPs",
      "blocks": [
        { "type": "usp", "settings": { "label": "Omega-Schutz" } },
        { "type": "usp", "settings": { "label": "Laborzertifiziert" } },
        { "type": "usp", "settings": { "label": "Gentechnikfrei" } },
        { "type": "usp", "settings": { "label": "Vegan" } },
        { "type": "usp", "settings": { "label": "Omega-3-reich" } },
        { "type": "usp", "settings": { "label": "Herstellung in Deutschland" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .product-usps {
    padding: 24px 16px;
  }

  .product-usps__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 32px;
    margin: 0 80px;
  }

  .product-usps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .product-usps__icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #ffffff;
    border-radius: 50%;
    padding: 12px;
  }

  .product-usps__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-usps__label {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    color: rgba(var(--color-foreground), 0.65);
  }

  @media screen and (max-width: 1000px) {
    .product-usps__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px 16px;
      margin: 0 auto;
    }
    .product-usps {
      padding: 32px 0;
    }
  }
  @media screen and (max-width: 749px) {
    .product-usps__label {
      font-size: 14px;
      font-weight: 400;
    }
  }
{% endstylesheet %}
